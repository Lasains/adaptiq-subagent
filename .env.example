# AdaptIQ Environment Variables
GEMINI_API_KEY=your_gemini_api_key_here
ADAPTIQ_SESSION_DIR=./session
ADAPTIQ_DB_URL=sqlite:///./adaptiq.db
ADAPTIQ_NODE_PATH=node
ADAPTIQ_SANDBOX_TIMEOUT_SECONDS=5
ADAPTIQ_TUTOR_TOKEN_BUDGET=4096
ADAPTIQ_ASSESSOR_TOKEN_BUDGET=2048
ADAPTIQ_DIAGNOSTICIAN_TOKEN_BUDGET=1024
ADAPTIQ_LOG_LEVEL=INFO
